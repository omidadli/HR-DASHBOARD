# ============================================================================
#  الگوی متغیرهای محیطی هوشا
#  این فایل را به .env کپی کنید:   cp .env.example .env
#  (.env در .gitignore است و هرگز commits نمی‌شود)
# ============================================================================

# --- الزامی -----------------------------------------------------------------
# کلید API جمنای. یک کلید «دائمی» با پیشوند AIza از این آدرس بسازید:
#   https://aistudio.google.com/apikey
# کلیدهایی که با AQ. شروع می‌شوند موقت (ephemeral) هستند و زیر یک ساعت باطل می‌شوند.
GEMINI_API_KEY=

# --- اختیاری ----------------------------------------------------------------
# مدل پیش‌فرض. اگر خالی بماند: gemini-3.8-flash
# (در صورت خطا، به‌ترتیب به gemini-2.5-flash و gemini-3.1-flash-lite سوئیچ می‌شود)
GEMINI_MODEL=

# مسیر پوشه داده‌ها (اسنپ‌شات JSON + فایل رزومه‌ها).
# پیش‌فرض: ./data — در Render با دیسک دائمی مثلاً /var/data
# DATA_DIR=/var/data

# پورت سرور. پیش‌فرض 3000 در محیط توسعه؛ Render خودش PORT را تزریق می‌کند.
# PORT=3000

# حداکثر اندازه بدنه JSON به مگابایت (رزومه‌ها base64 ارسال می‌شوند). پیش‌فرض: 64
# MAX_BODY_MB=64

# لاگ کردن درخواست‌های API (مقدار false یعنی خاموش). پیش‌فرض: روشن
# LOG_REQUESTS=true

# حالت اجرا: در توسعه خالی/development بگذارید.
# روی Render توسط blueprint به production تنظیم می‌شود — دستی تغییرش ندهید.
# NODE_ENV=production
